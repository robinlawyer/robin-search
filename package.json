{
  "name": "@robinlawyer/robin-search",
  "version": "1.2.2",
  "description": "Robin Search — servidor MCP local que indexa los expedientes del despacho y los hace buscables semánticamente sin que ningún documento salga del ordenador del abogado.",
  "type": "module",
  "license": "MIT",
  "author": "Robin Lawyer (Stay Hungry and Foolish, S.L.)",
  "homepage": "https://robinlawyer.ai",
  "bin": {
    "robin-search": "cli/index.js"
  },
  "main": "server/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "cli": "node cli/index.js",
    "check": "for f in $(git ls-files '*.js' 2>/dev/null || find . -name '*.js' -not -path './node_modules/*'); do node --check \"$f\" || exit 1; done && echo 'syntax OK'",
    "postinstall": "node scripts/patch-wasm.mjs || true",
    "patch:wasm": "node scripts/patch-wasm.mjs",
    "pack:mcpb": "node scripts/patch-wasm.mjs && npx @anthropic-ai/mcpb pack . dist/robin-search.mcpb"
  },
  "dependencies": {
    "@kenjiuno/msgreader": "^1.28.0",
    "@modelcontextprotocol/sdk": "^1.4.0",
    "@xenova/transformers": "^2.17.2",
    "7z-wasm": "^1.2.0",
    "adm-zip": "^0.6.0",
    "chokidar": "^3.6.0",
    "heic-convert": "^2.1.0",
    "mailparser": "^3.9.14",
    "mammoth": "^1.8.0",
    "mupdf": "^1.28.0",
    "node-unrar-js": "^2.0.2",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "^4.6.82",
    "rtf-stream-parser": "^3.8.1",
    "tesseract.js": "^7.0.0",
    "vectra": "^0.9.0",
    "xlsx": "^0.18.5"
  },
  "files": [
    "server",
    "cli",
    "manifest.json",
    "icon.png",
    "README.md"
  ]
}
